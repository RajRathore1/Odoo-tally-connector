<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groups -->
        <record model="res.groups" id="group_tally_admin">
            <field name="name">Tally Connector Admin</field>
            <field name="comment">Full access to Tally connector configuration and operations</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record model="res.groups" id="group_tally_operator">
            <field name="name">Tally Sync Operator</field>
            <field name="comment">Can execute synchronization jobs, view logs</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record Rules: Tally Connection - Multi-company isolation -->
        <record model="ir.rule" id="rule_tally_connection_multi_company">
            <field name="name">Tally Connection - Multi-company</field>
            <field name="model_id" ref="model_tally_connection"/>
            <field name="domain_force">[("company_id", "in", user.company_ids.ids)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rules: Allow Odoo Superuser to see all -->
        <record model="ir.rule" id="rule_tally_connection_superuser">
            <field name="name">Tally Connection - Superuser Override</field>
            <field name="model_id" ref="model_tally_connection"/>
            <field name="domain_force">[(1, "=", 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Record Rules: Stock Adjustment Log - Multi-company isolation via its connection -->
        <record model="ir.rule" id="rule_tally_stock_adjustment_log_multi_company">
            <field name="name">Tally Stock Adjustment Log - Multi-company</field>
            <field name="model_id" ref="model_tally_stock_adjustment_log"/>
            <field name="domain_force">[("connection_id.company_id", "in", user.company_ids.ids)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record model="ir.rule" id="rule_tally_stock_adjustment_log_superuser">
            <field name="name">Tally Stock Adjustment Log - Superuser Override</field>
            <field name="model_id" ref="model_tally_stock_adjustment_log"/>
            <field name="domain_force">[(1, "=", 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Record Rules: Agent Device - Multi-company isolation via its connection (Phase 6) -->
        <record model="ir.rule" id="rule_tally_agent_device_multi_company">
            <field name="name">Tally Agent Device - Multi-company</field>
            <field name="model_id" ref="model_tally_agent_device"/>
            <field name="domain_force">[("connection_id.company_id", "in", user.company_ids.ids)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record model="ir.rule" id="rule_tally_agent_device_superuser">
            <field name="name">Tally Agent Device - Superuser Override</field>
            <field name="model_id" ref="model_tally_agent_device"/>
            <field name="domain_force">[(1, "=", 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Record Rules: Agent Job - Multi-company isolation via its connection (Phase 6) -->
        <record model="ir.rule" id="rule_tally_agent_job_multi_company">
            <field name="name">Tally Agent Job - Multi-company</field>
            <field name="model_id" ref="model_tally_agent_job"/>
            <field name="domain_force">[("connection_id.company_id", "in", user.company_ids.ids)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record model="ir.rule" id="rule_tally_agent_job_superuser">
            <field name="name">Tally Agent Job - Superuser Override</field>
            <field name="model_id" ref="model_tally_agent_job"/>
            <field name="domain_force">[(1, "=", 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
