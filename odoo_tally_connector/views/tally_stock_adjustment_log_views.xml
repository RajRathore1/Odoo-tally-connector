<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_tally_stock_adjustment_log_list">
        <field name="name">tally.stock.adjustment.log.list</field>
        <field name="model">tally.stock.adjustment.log</field>
        <field name="arch" type="xml">
            <list string="Stock Adjustment Log" default_order="create_date desc" decoration-danger="not success">
                <field name="create_date" string="When"/>
                <field name="user_id"/>
                <field name="product_id"/>
                <field name="connection_id"/>
                <field name="direction"/>
                <field name="odoo_qty_before"/>
                <field name="tally_qty_before"/>
                <field name="target_qty"/>
                <field name="success" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_tally_stock_adjustment_log_form">
        <field name="name">tally.stock.adjustment.log.form</field>
        <field name="model">tally.stock.adjustment.log</field>
        <field name="arch" type="xml">
            <form string="Stock Adjustment Log" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="When"/>
                            <field name="user_id"/>
                            <field name="product_id"/>
                            <field name="connection_id"/>
                        </group>
                        <group>
                            <field name="direction"/>
                            <field name="odoo_qty_before"/>
                            <field name="tally_qty_before"/>
                            <field name="target_qty"/>
                            <field name="success"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_tally_stock_adjustment_log">
        <field name="name">Stock Adjustment Log</field>
        <field name="res_model">tally.stock.adjustment.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
