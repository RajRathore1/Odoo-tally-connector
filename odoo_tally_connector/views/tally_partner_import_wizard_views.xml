<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_tally_partner_import_wizard_form">
        <field name="name">tally.partner.import.wizard.form</field>
        <field name="model">tally.partner.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Contacts from Tally">
                <group>
                    <field name="connection_id" invisible="1"/>
                    <field name="partner_name" placeholder="Leave empty to import all customer and vendor ledgers"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_tally_partner_import_wizard">
        <field name="name">Import Contacts from Tally</field>
        <field name="res_model">tally.partner.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
