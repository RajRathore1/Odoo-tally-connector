<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_tally_agent_job_list">
        <field name="name">tally.agent.job.list</field>
        <field name="model">tally.agent.job</field>
        <field name="arch" type="xml">
            <list string="Agent Sync Timeline" default_order="create_date desc"
                  decoration-danger="state == 'failed'" decoration-success="state == 'done'"
                  decoration-muted="state == 'pending'" create="0">
                <field name="create_date" string="Queued At"/>
                <field name="connection_id"/>
                <field name="job_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'in_progress'"
                       decoration-muted="state == 'pending'"/>
                <field name="device_id"/>
                <field name="dispatched_at"/>
                <field name="completed_at"/>
                <field name="correlation_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_tally_agent_job_form">
        <field name="name">tally.agent.job.form</field>
        <field name="model">tally.agent.job</field>
        <field name="arch" type="xml">
            <form string="Agent Job" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="state" widget="badge" nolabel="1"
                                   decoration-success="state == 'done'"
                                   decoration-danger="state == 'failed'"
                                   decoration-info="state == 'in_progress'"
                                   decoration-muted="state == 'pending'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="device_id"/>
                            <field name="job_type"/>
                            <field name="correlation_id"/>
                        </group>
                        <group>
                            <field name="create_date" string="Queued At"/>
                            <field name="dispatched_at"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Request XML">
                            <field name="request_xml" nolabel="1" widget="text" readonly="1"/>
                        </page>
                        <page string="Response XML" invisible="not response_xml">
                            <field name="response_xml" nolabel="1" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_tally_agent_job_search">
        <field name="name">tally.agent.job.search</field>
        <field name="model">tally.agent.job</field>
        <field name="arch" type="xml">
            <search string="Search Agent Jobs">
                <field name="connection_id"/>
                <field name="correlation_id"/>
                <field name="device_id"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <group>
                    <filter name="group_by_connection" string="Connection" context="{'group_by': 'connection_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_tally_agent_job">
        <field name="name">Agent Sync Timeline</field>
        <field name="res_model">tally.agent.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tally_agent_job_search"/>
        <field name="context">{"search_default_filter_failed": 0}</field>
    </record>
</odoo>
